<table class="panel" width="620" cellpadding="0" cellspacing="0">
  <tr><th colspan="2">Confirm Sub-Account Request</th></tr>
  <tr><td colspan="2" style="padding:10px">
    <font size="2">Review the details below. This action opens a new account and
    cannot be undone from this screen.</font>
  </td></tr>
  <tr><td class="lbl">Member</td><td><%= member.name %> (<%= member.id %>)</td></tr>
  <tr><td class="lbl">Sub-Account Type</td><td><%= pending.subType %></td></tr>
  <tr><td class="lbl">Nickname</td><td><%= pending.nickname %></td></tr>
  <tr><td class="lbl">Initial Deposit</td><td><%= fmt(Number(pending.deposit)) %></td></tr>
  <tr><td class="lbl">Funding Account</td><td><%= pending.funding %></td></tr>
  <tr><td colspan="2" style="padding:10px">
    <form method="post" action="<%= linkBase %>/members/<%= member.id %>/subaccount/commit">
      <%/* Irreversible. The policy engine classifies this as write_irreversible,
           which means discovery will not press it without an explicit flag and
           replay will not press it unless the artifact is approved. */%>
      <input type="submit" id="<%= btnConfirm %>" value="Confirm and Open Account">
      &nbsp;
      <a href="<%= linkBase %>/members/<%= member.id %>/subaccount/new"><font size="2">Cancel</font></a>
    </form>
  </td></tr>
</table>
