<table class="panel" width="760" cellpadding="0" cellspacing="0">
  <tr><th colspan="4">Member Detail</th></tr>
  <tr>
    <td class="lbl"><%= tenant.memberIdLabel %></td><td><b><%= member.id %></b></td>
    <td class="lbl">Status</td><td><%= member.status %></td>
  </tr>
  <tr>
    <td class="lbl">Name</td><td><%= member.name %></td>
    <td class="lbl">Member Since</td><td><%= member.joined %></td>
  </tr>
  <tr>
    <%/* Regulated data rendered on the page exactly as a real servicing screen
         would. It is here so that evidence capture has to deal with it, and so
         tests/safety can prove it never survives to disk. */%>
    <td class="lbl">Tax ID</td><td><%= member.ssn %></td>
    <td class="lbl">Card on File</td><td><%= member.card %></td>
  </tr>
  <tr><td class="lbl">Servicing Memo</td><td colspan="3"><%= member.memo %></td></tr>
</table>

<br>

<table class="panel" width="760" cellpadding="0" cellspacing="0" summary="Accounts">
  <caption align="left" style="padding:4px 0">
    <font size="2" color="#1f3d6b"><b>Accounts</b></font>
  </caption>
  <tr>
    <th>Account Number</th><th>Type</th><th>Status</th>
    <th align="right">Current Balance</th><th>Action</th>
  </tr>
  <% member.accounts.forEach(function (a, i) { %>
    <tr>
      <td><%= a.number %></td>
      <td><%= a.type %></td>
      <td><%= a.status %></td>
      <td align="right"><%= fmt(a.balance) %></td>
      <%/* Every row's link is the word "View". Role+name alone is ambiguous
           here, which is precisely why the table_cell_relative strategy exists:
           the row is identified by its data, the same way a human finds it. */%>
      <td><a href="<%= linkBase %>/members/<%= member.id %>/accounts/<%= a.number %>"
             id="<%= ctl('grdAccounts','lnkView', i) %>">View</a></td>
    </tr>
  <% }); %>
</table>

<br>
<table width="760"><tr><td>
  <form method="get" action="<%= linkBase %>/members/<%= member.id %>/subaccount/new">
    <input type="submit" id="<%= ctl('pnlActions','btnOpenSub') %>" value="Open Sub-Account">
  </form>
</td></tr></table>
