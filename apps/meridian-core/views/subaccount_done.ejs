    <div class="ok" role="status">
      Sub-account created successfully.
    </div>
    <br>
    <table cellpadding="4" cellspacing="0" border="0">
      <tr><td class="lbl">Reference Number</td>
          <td><font size="3"><b><%= reference %></b></font></td></tr>
      <tr><td class="lbl">Account Number</td><td><%= accountNumber %></td></tr>
      <tr><td class="lbl">Type</td><td><%= pending.subType %></td></tr>
      <tr><td class="lbl">Opening Balance</td><td><%= fmt(Number(pending.deposit)) %></td></tr>
    </table>
  </td></tr>
</table>
