<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN">
<html>
<head>
  <title><%= title %></title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <%- include('_styles') %>
  <style type="text/css">
    #contentFrame { width:100%; height:calc(100vh - 76px); border:0; display:block; }
  </style>
</head>
<body>

<table width="100%" cellpadding="0" cellspacing="0" class="hdr"><tr>
  <td><font size="4" color="#ffffff"><b><%= tenant.brandName %></b></font>
      <font size="1" color="#bccbe4">&nbsp;&nbsp;<%= tenant.productLine %></font></td>
  <td align="right">
    <% if (user) { %>
      <font size="1" color="#bccbe4">Operator:</font>
      <font size="1" color="#ffffff"><b><%= user %></b></font>
      &nbsp;<a href="/logout" style="color:#bccbe4;font-size:11px">Sign Out</a>
    <% } %>
  </td>
</tr></table>

<table width="100%" cellpadding="0" cellspacing="0" class="nav"><tr><td>
  <a href="/members/search">Member Search</a> &nbsp;|&nbsp;
  <a href="/members/search">Accounts</a> &nbsp;|&nbsp;
  <a href="/members/search">Transactions</a>
</td></tr></table>

<%/* Every working screen lives in here. In-frame links navigate the frame, so
     the address bar stops changing - which is exactly why checkpoints in this
     system are written against the accessibility tree and not against the url. */%>
<iframe id="contentFrame" name="contentFrame" title="Content" src="<%= frameSrc %>"></iframe>

</body>
</html>
