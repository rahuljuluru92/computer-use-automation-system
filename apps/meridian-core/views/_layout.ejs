<%
/* Deliberately period-accurate markup: table layout, <font> tags, spacer gifs in
   spirit if not in fact, and control ids that change on every render. The
   accessibility tree is still correct - labels are associated, roles are
   implicit-but-right - which is the realistic case. Legacy enterprise apps are
   usually semantically salvageable; they are just not selector-friendly. */
%><!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN">
<html>
<head>
  <title><%= title %> - Meridian Core</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <style type="text/css">
    body { background:#eef1f5; margin:0; font-family:Verdana,Arial,sans-serif; font-size:11px; }
    .hdr { background:#1f3d6b; color:#fff; }
    .hdr td { padding:10px 14px; }
    .nav { background:#dce3ee; border-bottom:1px solid #9fb0cc; }
    .nav td { padding:5px 10px; }
    .nav a { color:#1f3d6b; text-decoration:none; font-size:11px; }
    .panel { background:#fff; border:1px solid #9fb0cc; }
    .panel th { background:#c9d6e8; text-align:left; padding:5px 8px; font-size:11px;
                border-bottom:1px solid #9fb0cc; }
    .panel td { padding:5px 8px; border-bottom:1px solid #e2e7ef; font-size:11px; }
    .lbl { text-align:right; color:#334; width:170px; }
    .err { background:#ffe9e9; border:1px solid #cc5555; color:#a00; padding:8px; }
    .ok  { background:#eaffea; border:1px solid #55aa55; color:#060; padding:8px; }
    .modal { position:fixed; top:0; left:0; width:100%; height:100%;
             background:rgba(20,30,50,.55); }
    .modalbox { background:#fff; border:2px solid #1f3d6b; width:420px;
                margin:120px auto; padding:14px; }
    input[type=text], input[type=password], select { font-family:Verdana; font-size:11px;
             border:1px solid #8fa2c0; padding:2px; }
    input[type=submit] { font-family:Verdana; font-size:11px; padding:2px 10px; }
  </style>
</head>
<body>

<table width="100%" cellpadding="0" cellspacing="0" class="hdr"><tr>
  <td><font size="4" color="#ffffff"><b>MERIDIAN CORE</b></font>
      <font size="1" color="#bccbe4">&nbsp;&nbsp;Servicing Console v7.2.14</font></td>
  <td align="right">
    <% if (user) { %>
      <font size="1" color="#bccbe4">Operator:</font>
      <font size="1" color="#ffffff"><b><%= user %></b></font>
      &nbsp;<a href="/logout" style="color:#bccbe4;font-size:11px">Sign Out</a>
    <% } %>
  </td>
</tr></table>

<% if (user) { %>
<table width="100%" cellpadding="0" cellspacing="0" class="nav"><tr><td>
  <a href="/members/search">Member Search</a> &nbsp;|&nbsp;
  <a href="/members/search">Accounts</a> &nbsp;|&nbsp;
  <a href="/members/search">Transactions</a>
</td></tr></table>
<% } %>

<table width="100%" cellpadding="14"><tr><td>
<%- body %>
</td></tr></table>

<% if (typeof surpriseModal !== 'undefined' && surpriseModal) { %>
  <%/* An interstitial the recorded flow never saw. A capability that only works
       when nothing unexpected appears is not a capability. */%>
  <div class="modal">
    <div class="modalbox" role="dialog" aria-label="<%= surpriseModal.title %>">
      <font size="3" color="#1f3d6b"><b><%= surpriseModal.title %></b></font>
      <br><br>
      <font size="2"><%= surpriseModal.body %></font>
      <br><br>
      <form method="post" action="/_dismiss">
        <input type="hidden" name="back" value="<%= currentPath %>">
        <input type="submit" id="<%= ctl('modal','btnAck') %>" value="Acknowledge">
      </form>
    </div>
  </div>
<% } %>

</body>
</html>
