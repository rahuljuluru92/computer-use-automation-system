# Required only for `npm run discover` (the LLM-driven discovery run).
# `npm run replay` deliberately needs NO key at all - that is the point of the system.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for discovery. Defaults to claude-opus-5 when unset - driving an
# unfamiliar legacy UI without hallucinating a control is the hard case, and
# trading accuracy for price here is a decision worth making on purpose.
# CUA_DISCOVERY_MODEL=claude-opus-5

# Meridian Core (the local hostile target app)
MERIDIAN_PORT=4400
MERIDIAN_BASE_URL=http://localhost:4400

# Demo credentials for Meridian Core. Fake, local-only, and never written to
# artifacts or evidence - see src/core/redact.ts and tests/safety/.
MERIDIAN_USERNAME=teller01
MERIDIAN_PASSWORD=local-demo-only
